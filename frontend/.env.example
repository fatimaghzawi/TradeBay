# Same-origin API via Next rewrites (see next.config.ts).
# Default proxy target is http://127.0.0.1:8000 — override if your API listens elsewhere.
# API_PROXY_TARGET=http://127.0.0.1:8000
# Only set NEXT_PUBLIC_API_URL when the API is on a different public host:
# NEXT_PUBLIC_API_URL=https://api.example.com
