# Application
APP_ENV=development
APP_NAME=TradeBay
APP_DEBUG=true
LOG_LEVEL=INFO

# Secrets — generate unique values per environment. Never commit real secrets.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_SECRET_KEY=change-me-to-a-different-long-random-string-32
JWT_ALGORITHM=HS256

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# MongoDB
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DATABASE=tradebay

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Rate limiting (integration point)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

AI_PROVIDER=stub
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
# Transport faults (timeouts, 5xx) and schema corrections get separate budgets.
AI_MAX_RETRIES=1
AI_STRUCTURED_RETRIES=1
AI_MODEL=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_CANDIDATES=80
AI_TOP_K=24
# Turn on only when this MongoDB deployment has an Atlas vector index.
AI_VECTOR_SEARCH_ENABLED=false
AI_EMBEDDING_SYNC_BATCH=32
# Category names only — never price, stock, or eligibility.
AI_CATEGORY_CACHE_SECONDS=60
# Model-backed requests per business per day. 0 disables the cap.
AI_DAILY_REQUEST_QUOTA=200

# Observability integration points (unused until wired)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Email — Elastic Email transactional API (leave blank to log-only in development)
# EMAIL_FROM must be a mailbox on a domain you own and verified in Elastic Email.
# Do not use Gmail/Outlook here — Gmail will show "via bounces.elasticemail.net" and flag phishing.
ELASTICEMAIL_API_KEY=
EMAIL_FROM=TradeBay <noreply@your-domain.com>
EMAIL_TIMEOUT_SECONDS=30

# Optional override for the seeded platform admin (default AdminPass123!)
# PLATFORM_ADMIN_PASSWORD=
# Required to accept carrier tracking webhooks (fail-closed when empty)
TRACKING_WEBHOOK_SECRET=

# Stripe card payments (test keys start with sk_test_ / pk_test_ / whsec_).
# Card checkout stays disabled until STRIPE_SECRET_KEY is set. Never commit real keys.
# Webhook endpoint: POST {API}/api/v1/payments/stripe/webhook
#   events: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

