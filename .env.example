# Application
APP_ENV=development
APP_NAME=TradeBay
APP_DEBUG=true
LOG_LEVEL=INFO

# Secrets — generate unique values per environment. Never commit real secrets.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_SECRET_KEY=change-me-to-a-different-long-random-string-32JWT_ALGORITHM=HS256

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# MongoDB
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DATABASE=tradebay

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Rate limiting (integration point)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# AI (optional in skeleton — leave blank to use the stub provider)
AI_PROVIDER=stub
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MODEL=
# RAG for AI sourcing (catalog vocabulary context). Off by default.
# AI_RAG_MODE=lexical uses in-process TF-IDF; embedding needs AI_API_KEY.
AI_RAG_ENABLED=false
AI_RAG_MODE=lexical
AI_RAG_TOP_K=8
AI_RAG_PRODUCT_LIMIT=400
AI_EMBEDDING_MODEL=text-embedding-3-small

# Observability integration points (unused until wired)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Email — Elastic Email transactional API (leave blank to log-only in development)
# EMAIL_FROM must be a mailbox on a domain you own and verified in Elastic Email.
# Do not use Gmail/Outlook here — Gmail will show "via bounces.elasticemail.net" and flag phishing.
ELASTICEMAIL_API_KEY=
EMAIL_FROM=TradeBay <noreply@your-domain.com>
EMAIL_TIMEOUT_SECONDS=30

# Optional override for the seeded platform admin (default AdminPass123!)
# PLATFORM_ADMIN_PASSWORD=
# Required to accept carrier tracking webhooks (fail-closed when empty)
TRACKING_WEBHOOK_SECRET=

