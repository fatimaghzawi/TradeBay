# Application
APP_ENV=development
APP_NAME=TradeBay
APP_DEBUG=true
LOG_LEVEL=INFO

# Secrets — generate unique values per environment. Never commit real secrets.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_SECRET_KEY=change-me-to-a-different-long-random-string-32JWT_ALGORITHM=HS256

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# MongoDB
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DATABASE=tradebay

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Rate limiting (integration point)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# AI (optional in skeleton — leave blank to use the stub provider)
AI_PROVIDER=stub
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MODEL=

# Observability integration points (unused until wired)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
